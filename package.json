{
  "name": "@hiveio/wallet-dapp",
  "version": "1.1.0",
  "private": false,
  "description": "Metamask Wallet dApp",
  "homepage": "https://gitlab.syncad.com/hive/wallet-dapp#readme",
  "bugs": {
    "url": "https://gitlab.syncad.com/hive/wallet-dapp/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.syncad.com/hive/wallet-dapp.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "nuxt dev",
    "dev": "nuxt dev",
    "test": "pnpm run test:e2e",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "npm run lint-ci -- --fix",
    "lint-ci": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js",
    "postinstall": "prisma generate && nuxt prepare",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "regenerate-ctokens-api": "pnpm --package @hiveio/wax-spec-generator dlx generate-wax-spec -o src/utils/wallet/ctokens/api -i",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "pnpm": {
    "overrides": {
      "vue": "catalog:vue-toolset"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@hiveio/beekeeper": "catalog:hiveio-toolset",
    "@hiveio/wax": "catalog:hiveio-toolset",
    "@hiveio/wax-signers-beekeeper": "catalog:hiveio-toolset",
    "@hiveio/wax-signers-external": "catalog:hiveio-toolset",
    "@hiveio/wax-signers-keychain": "catalog:hiveio-toolset",
    "@hiveio/wax-signers-metamask": "catalog:hiveio-toolset",
    "@hiveio/wax-signers-peakvault": "catalog:hiveio-toolset",
    "@mdi/js": "^7.4.47",
    "@metamask/providers": "^16.0.0",
    "@mtyszczak-cargo/htm": "^1.4.0",
    "@nabla/vite-plugin-eslint": "^2.0.6",
    "@nuxt/eslint": "1.9.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^1.0.3",
    "@playwright/test": "catalog:playwright-toolset",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@tailwindcss/vite": "catalog:tailwind-toolset",
    "@tanstack/vue-table": "^8.21.2",
    "@types/google.accounts": "^0.0.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "lucide-vue-next": "^0.477.0",
    "nuxt": "catalog:vue-toolset",
    "pinia": "catalog:vue-toolset",
    "prisma": "7.10.0",
    "reka-ui": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "catalog:tailwind-toolset",
    "terser": "catalog:terser",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:typescript-toolset",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.2",
    "vite-plugin-eslint2": "^5.0.4",
    "vue": "catalog:vue-toolset",
    "vue-router": "4",
    "vue-sonner": "^1.3.0",
    "vue-tsc": "catalog:vue-toolset"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "google-auth-library": "^10.4.2",
    "googleapis": "^140.0.0",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "marked": "^17.0.1",
    "qrcode": "^1.5.4"
  }
}
