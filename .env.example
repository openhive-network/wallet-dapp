## To use this, rename to `.env` and set the production NUXT_PUBLIC_SNAP_ORIGIN here
NUXT_PUBLIC_SNAP_ORIGIN=
## Uncomment this if you want to use a specific version of the Snap runtime:
# NUXT_PUBLIC_SNAP_VERSION=

## Uncomment this if you want to show HTM in the menu
# NUXT_PUBLIC_SHOW_HTM_IN_MENU=true

## L1 Proxy Configuration
## Set to false to disable L1 proxy functionality (app will work in pure L2 mode)
# NUXT_PUBLIC_ENABLE_L1_PROXY=true
## The Hive account used as proxy for L1 transactions
# NUXT_PUBLIC_HTM_PROXY_ACCOUNT=htm.proxy

# Custom Tokens API Configuration
# Set this to your ctokens-api server URL
# Example for local development: http://localhost:3000/ctokens-api
# Example for remote server: https://api.example.com/ctokens-api
# Leave empty to use default relative path /ctokens-api
NUXT_PUBLIC_CTOKENS_API_URL=
NUXT_PUBLIC_HIVE_NODE_ENDPOINT=
NUXT_PUBLIC_HIVE_CHAIN_ID=
NUXT_GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Your Google Wallet Issuer ID. You can find it on Google Pay and Wallet Console -> Google Wallet API, as IssuerID
NUXT_GOOGLE_WALLET_ISSUER_ID=

# Google Drive Integration
# Get these from https://console.cloud.google.com/
# 1. Enable Google Drive API in APIs & Services -> Library
# 2. Go to APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
NUXT_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NUXT_GOOGLE_CLIENT_SECRET=your-client-secret
# 3. Go to APIs & Services -> Credentials -> Create Credentials -> API key
NUXT_GOOGLE_API_KEY=your-api-key
# This is the filename used to store data in the user's Google Drive App Data folder
NUXT_GOOGLE_DRIVE_STORAGE_FILE=profile_data.json

# App URL (for OAuth callbacks)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# For development, you can set a mock server URL
# NUXT_PUBLIC_CTOKENS_API_URL=http://localhost:8080/mock-ctokens-api

# Account Onboarding via QR Code (/features/request-account -> /features/create-account)
# Optional module - leave the creator account/key empty to keep it disabled (hidden in the menu); the rest of the app works as usual.
# QR code refresh interval in seconds - each refresh issues a fresh token (default: 3)
# NUXT_ACCOUNT_REQUEST_TOKEN_INTERVAL=3
# Prisma datasource URL of the SQLite database storing claimed tokens (default: file:./.data/account-requests.sqlite).
# In Docker the .data directory is created during the build and mounted at /app/.data (run_instance.sh --data-dir).
# Locally, run `pnpm db:push` once. Leave empty to keep the account-request module disabled.
# NUXT_ACCOUNT_REQUEST_DATABASE_URL=file:./.data/account-requests.sqlite
# Hive account that pays for / signs the account creation and its ACTIVE private key (WIF).
# The private key also encrypts the QR code tokens (issue timestamp encrypted with beekeeper memo encryption).
NUXT_ACCOUNT_CREATOR_ACCOUNT=
NUXT_ACCOUNT_CREATOR_ACTIVE_KEY=
# Set to true to spend claimed account tokens (create_claimed_account_operation) instead of paying the creation fee
# NUXT_ACCOUNT_CREATOR_USE_CLAIMED_ACCOUNTS=false
